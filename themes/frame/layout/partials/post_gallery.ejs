<div class="post-gallery">
    <div class="gallery-layout-toggle">
        <div class="layout-pill">
            <button class="layout-btn active" data-layout="single" aria-label="Single column view">
                <span class="layout-label">Single</span>
            </button>
            <button class="layout-btn" data-layout="double" aria-label="Double column view">
                <span class="layout-label">Double</span>
            </button>
        </div>
    </div>
    <div class="post-gallery-list">
        <% page.posts.each(function (post) { %>
            <div class="post-gallery-item">
                <div class="post-info">
                    <div class="tag-list">
                        <% if (post.tags && post.tags.data && post.tags.data.length > 0) {%>
                            <% post.tags.data.forEach(function(tag) { %>
                                <span class="post-tag">
                                    <a href="<%-url_for(tag.path)%>">
                                        <%=tag.name%>
                                    </a>
                                </span>   
                            <% }) %>           
                        <% } %>
                    </div>
                    <div class="post-title">
                        <a href="<%=url_for(post.path)%>"</a>
                            <% if (post.title) {%>
                                <%= post.title %>
                            <% } else {%>
                                *Untitled
                            <% } %>
                        </a>
                    </div>
                    <span class="post-date">
                        <%- date(post.date, theme.date_format) %>
                    </span>
                </div>
                <div class="post-img">
                <% if (post.featured_image) {%>
                    <img src="<%= url_for(post.featured_image)%>" alt="featured_image">
                <% } %>  
                </div>
            </div>
            <div class="h-line-secondary"></div>
        <% }) %>
    </div>
    <div id="paginator">
        <%- partial('partials/paginator') %>
    </div>
</div>
<script src="<%- url_for('/js/gallery.js') %>"></script>
