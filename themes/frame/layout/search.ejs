<div class="search-page">
    <div class="search-header">
        <div class="search-input-container">
          <input autocomplete="off" autocapitalize="off" maxlength="80"
                 placeholder="<%=theme.local_search.place_holder%>" spellcheck="false"
                 type="search" class="search-input" id="search-input">
        </div>
    </div>
    <div class="search-result-container" id="search-result-container">
        <div class="search-result-message" id="search-result-message"></div>
        <ul class="search-result-list" id="search-result-list"></ul>
    </div>
</div>

<script>
    const searchConfig = {
        path             : "<%=url_for(theme.local_search.path || 'search.json')%>",
        top_n_per_article: "<%=theme.local_search.top_n_per_article%>",
        unescape         : "<%=theme.local_search.unescape%>",
        trigger: "<%=theme.local_search.trigger%>",
        preload: "<%=theme.local_search.preload%>"
    };
</script>
<script src="<%- url_for('/js/searchdb.js') %>"></script>
<script src="<%- url_for('/js/search_page.js') %>"></script>
