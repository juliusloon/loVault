.post-content 
    margin-top $margin-l-1

h1, h2, h3, h4, h5, h6
    margin-top $margin-l-0
    margin-bottom $margin-m-1

h1
    text-style(heading-h1)

h2
    text-style(heading-h2)

h3
    text-style(heading-h3)

h4
    text-style(heading-h4)

h5
    text-style(heading-h5)

h6
    text-style(heading-h6)
    
p
    text-style(body-default)

strong
    text-style(body-bold)

em
    text-style(body-italic)

del 
    text-style(body-delete)

.post-content
    a 
        underline-motion(underline-link)

blockquote
    margin-left 0
    margin-right 0
    margin-top $margin-m-2
    border-left $margin-s-2 solid $color-text-secondary

    p
        margin-left $margin-m-2
        margin-top 0
        margin-bottom 0
        margin-right $margin-m-2
        padding-top $margin-m-0
        padding-bottom $margin-m-0

    blockquote
        margin-left $margin-m-2
        margin-top 0
        margin-bottom 0

// Callout styles (Obsidian-style [!quote] etc.)
.callout
    margin-left 0
    margin-right 0
    margin-top $margin-m-2
    padding $margin-m-2
    border-radius 4px
    border-left $margin-s-2 solid $color-text-secondary
    background rgba(#AFAEA9, 0.05)

    .callout-title
        font-weight 600
        margin-bottom $margin-m-1

    .callout-content
        p
            margin-left 0
            margin-right 0
            padding-top 0
            padding-bottom 0

    &.callout-quote
        border-left-color #6a9955
        background rgba(#6a9955, 0.1)

    &.callout-note
        border-left-color #4a90d9
        background rgba(#4a90d9, 0.1)

    &.callout-tip
        border-left-color #dcdcaa
        background rgba(#dcdcaa, 0.1)

    &.callout-warning
        border-left-color #ce9178
        background rgba(#ce9178, 0.1)

    &.callout-danger
        border-left-color #f14c4c
        background rgba(#f14c4c, 0.1)

    &.callout-info
        border-left-color #4a90d9
        background rgba(#4a90d9, 0.1)

    &.callout-success
        border-left-color #6a9955
        background rgba(#6a9955, 0.1)

    &.callout-question
        border-left-color #9b72cf
        background rgba(#9b72cf, 0.1)

    &.callout-important
        border-left-color #d9730d
        background rgba(#d9730d, 0.1)

    &.callout-caution
        border-left-color #f5a623
        background rgba(#f5a623, 0.1)

    &.callout-abstract
    &.callout-summary
    &.callout-tldr
        border-left-color #0db7d6
        background rgba(#0db7d6, 0.1)

    &.callout-todo
        border-left-color #4a90d9
        background rgba(#4a90d9, 0.1)

    &.callout-example
        border-left-color #6a9955
        background rgba(#6a9955, 0.1)

    &.callout-bug
        border-left-color #f14c4c
        background rgba(#f14c4c, 0.1)

    &.callout-fail
    &.callout-failure
        border-left-color #f14c4c
        background rgba(#f14c4c, 0.1)

    // Ensure markdown emphasis inside callouts renders correctly
    .callout-content
        strong
            text-style(body-bold)
        em
            text-style(body-italic)
        code
            text-style(code-default)
        a
            underline-motion(link)

.post-content
    li
        text-style(body-default)
        margin-top $margin-m-0

    ol 
        padding-left $margin-l-0
        margin-left $margin-m-1
        margin-right $margin-m-1
        margin-top $margin-m-2

        ol
            margin-top $margin-m-0

    ul 
        padding-left $margin-l-0
        margin-left $margin-m-1
        margin-right $margin-m-1
        margin-top $margin-m-2

        ul 
            margin-top $margin-m-0

        li 
            list-style-type disc
            

    .task-list
        padding-left 0
        .task-list-item 
            list-style none
    
dl 
    dt 
        padding $margin-m-0 0
        text-style(body-bold)

    dt::after
        content " :"

    dd 
        margin 0

            

// KaTeX display: horizontal scroll for long equations
.katex-display
    overflow-x auto
    padding-bottom 0.5em
    // Ensure scrollbar is thin and unobtrusive
    &::-webkit-scrollbar
        height 4px
    &::-webkit-scrollbar-track
        background transparent
    &::-webkit-scrollbar-thumb
        background $color-text-secondary
        border-radius 2px
    // Firefox
    scrollbar-width thin
    scrollbar-color $color-text-secondary transparent
