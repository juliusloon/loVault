body
  margin 0

.mask-border::before
  content ''
  position fixed
  top 0
  right 0
  bottom 0
  left 0
  border $line-primary $color-text-primary solid
  pointer-events none
  z-index 8

.wrapper
  display flex
  flex-direction column
  min-height 100vh

.main 
  flex-grow 1
  padding 0
  margin 0